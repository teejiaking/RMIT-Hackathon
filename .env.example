DATABASE_URL="file:./trustvault.db"
AUTH_MODE="demo"
# Normal production startup rejects demo auth. npm run demo is an explicit loopback-only preview.
APP_ORIGIN="http://127.0.0.1:3000"
# Generate both with npm run demo:setup. Never commit real keys.
SESSION_SECRET=""
DOCUMENT_ENCRYPTION_KEY=""
STORAGE_DIR="./private-storage"
# Real mode: AUTH_MODE=tidecloak; server-only adapter JSON downloaded from your realm client
TIDECLOAK_CONFIG_JSON=""
TIDECLOAK_ISSUER=""
TIDECLOAK_CLIENT_ID="trustvault"
# For OIDC code+PKCE, use a confidential client and configure its secret server-side.
TIDECLOAK_CLIENT_SECRET=""
